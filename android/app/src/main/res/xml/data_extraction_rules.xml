<?xml version="1.0" encoding="utf-8"?>
<!--
  D1-13: ningún dato de la app sale del teléfono por mecanismos del sistema.
  Android 12+ (API 31+): excluye todos los dominios de la copia a la nube y de la
  transferencia al migrar de teléfono. Android 11 o anterior: lo cubre
  android:allowBackup="false" en el manifest.
  El IndexedDB del WebView vive bajo app_webview/, dentro del dominio "root".
  Costo: al cambiar de teléfono, el vault solo pasa con un backup exportado.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
